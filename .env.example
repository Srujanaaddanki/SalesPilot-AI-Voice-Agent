# Primary LLM Provider: "auto" (prefers Groq, then Gemini, then local fallback), "groq", "gemini", or "fallback"
LLM_PROVIDER=auto

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local SQLite Database Path (Optional override)
SALESPILOT_DB_PATH=database/salespilot.db
